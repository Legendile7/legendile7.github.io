---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Divesh Gupta" homepage>
  <section class="hero">
    <h1>Divesh Gupta</h1>
    <p class="summary">I do security research, build tools, and make games.</p>
    <a class="text-link" href="/work/">See my work <Icon name="arrow" size={18} /></a>
  </section>
</Base>

<style>
  .hero { min-height: calc(100svh - 90px - 16vw); display: flex; flex-direction: column; justify-content: center; max-width: 60ch; padding-bottom: 6vh; }
  .hero h1 { margin-bottom: 18px; text-shadow: 0 0 40px rgba(233, 184, 114, 0.18); }
  .summary { color: var(--ink); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.45; max-width: 40ch; margin-bottom: 2rem; }

  @keyframes arrive { from { opacity: 0; translate: 0 12px; } to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .hero > * { animation: arrive 700ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hero h1 { animation-delay: 60ms; }
    .hero .summary { animation-delay: 140ms; }
    .hero .text-link { animation-delay: 220ms; }
  }
</style>
